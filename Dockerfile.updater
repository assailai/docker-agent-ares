# =============================================================================
# Ares companion updater - keeps the agent on the version the server marks current.
# =============================================================================
# Applies updates via the platform (Docker socket in docker mode, the in-cluster API in k8s
# mode) and verifies the target image's cosign signature before applying. The agent stays
# unprivileged; only this updater touches the runtime.
# =============================================================================

# cosign verifies the target image's signature (the root of trust) before applying, so every
# auto-update trusts this binary's answer.
#
# v3.1.4, not the last v2: scanned on 2026-10-29, v2.6.5 still carried 37 fixable High/Critical
# findings in its Go dependencies and v3.1.4 none. Checked against verify.py before the move: the
# same arguments verify the signatures CI produces, `--output json` keeps the shape
# _verified_digest reads, and a wrong signer or an unsigned image is still refused.
#
# built from source for now (ARES-2046): the v3.1.4 release compiles in klauspost/compress
# v1.20.1, which has GO-2026-6865 (a zstd panic, fixed in v1.20.2), and docker-build.yml refuses a
# fixable High. On 2026-11-07 no cosign release had the fix yet.
#
# instead of the release checksum we have the tag's commit (a moved tag fails the clone check), a
# toolchain pinned by digest that cannot fetch another, and sum.golang.org checking the two go.sum
# lines `go get` adds.
#
# the go.mod check below fails the build once upstream ships anything but COSIGN_COMPRESS_UPSTREAM,
# so bumping COSIGN_VERSION cannot keep a stale override, or downgrade a newer compress. When that
# happens, drop this stage and download the release again, checked against cosign_checksums.txt
# (see this file before ARES-2046).
#
# built on $BUILDPLATFORM and cross-compiled with CGO off, so arm64 needs no emulated Go build and
# the static binary runs on alpine.
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS cosign
ARG TARGETOS
ARG TARGETARCH
ARG COSIGN_VERSION=v3.1.4
ARG COSIGN_COMMIT=0e48502cf5ef34e2e60bbd3617aa19945712f705
ARG COSIGN_COMPRESS_UPSTREAM=v1.20.1
ARG COSIGN_COMPRESS_OVERRIDE=v1.20.3
ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local
RUN apk add --no-cache git \
    && git clone --quiet --depth 1 --branch "${COSIGN_VERSION}" \
       https://github.com/sigstore/cosign.git /src \
    && actual="$(git -C /src rev-parse HEAD)" \
    && if [ "${actual}" != "${COSIGN_COMMIT}" ]; then \
         echo "cosign ${COSIGN_VERSION} is ${actual}, expected ${COSIGN_COMMIT}; refusing" >&2; \
         exit 1; \
       fi
WORKDIR /src
RUN --mount=type=cache,target=/go/pkg/mod \
    upstream="$(awk '$1 == "github.com/klauspost/compress" { print $2 }' go.mod)" \
    && if [ "${upstream}" != "${COSIGN_COMPRESS_UPSTREAM}" ]; then \
         echo "cosign ${COSIGN_VERSION} ships klauspost/compress ${upstream:-none}, not" \
              "${COSIGN_COMPRESS_UPSTREAM}: drop this override and go back to the" \
              "checksum-verified release download (see the comment above)" >&2; \
         exit 1; \
       fi \
    && go get "github.com/klauspost/compress@${COSIGN_COMPRESS_OVERRIDE}"
# the version flags are the ones cosign's own Makefile sets, so `cosign version` names the tag and
# its commit; it reports v3.1.4+dirty, because go.mod is not upstream's
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" go build -trimpath \
      -ldflags "-buildid= -s -w \
        -X sigs.k8s.io/release-utils/version.gitVersion=${COSIGN_VERSION} \
        -X sigs.k8s.io/release-utils/version.gitCommit=${COSIGN_COMMIT} \
        -X sigs.k8s.io/release-utils/version.gitTreeState=dirty" \
      -o /out/cosign ./cmd/cosign

FROM python:3.12-alpine

LABEL org.opencontainers.image.title="Ares Updater"
LABEL org.opencontainers.image.source="https://github.com/assailai/ares-agent"
LABEL org.opencontainers.image.vendor="Assail AI"

COPY --from=cosign /out/cosign /usr/local/bin/cosign
COPY requirements-updater.txt /tmp/requirements-updater.txt
# apk upgrade, and the ADD that makes it rerun against a cache: see the agent's Dockerfile for
# both (zlib 1.4-r0 was in Alpine before the python image; krb5-libs 1.22.3-r0 was in Alpine
# before this layer's cache entry expired).
ADD https://dl-cdn.alpinelinux.org/alpine/latest-stable/main/x86_64/APKINDEX.tar.gz /usr/share/ares/apkindex.tar.gz
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && pip install --no-cache-dir -r /tmp/requirements-updater.txt \
    && rm -rf /var/cache/apk/* /tmp/requirements-updater.txt

# Same CA mount points as the agent image: the host's store at /host-ca, the manual drop-in at
# /certs. updater.tlsconf merges whatever it finds here into one bundle and exports SSL_CERT_FILE,
# which is what lets the cosign subprocess verify signatures through a TLS-inspecting proxy.
RUN mkdir -p /host-ca /certs && chmod 555 /host-ca /certs

WORKDIR /app
COPY updater/ ./updater/
# the release this image is, which the updater reads so it never moves itself backwards
# (main._is_backwards). Written from the one version source at build time; an ENV would not do,
# since a successor carries its predecessor's environment and would inherit the older release.
COPY agent/__version__.py /tmp/release.py
RUN sed -n 's/^__version__ = "\(.*\)"$/\1/p' /tmp/release.py > updater/RELEASE \
    && rm /tmp/release.py \
    && test -s updater/RELEASE
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Runs as root: docker mode needs the socket (host-equivalent access by design); k8s mode
# uses its ServiceAccount.
ENTRYPOINT ["python", "-m", "updater.main"]
